--- scripts/run_daily_top_movers_research.py
+++ scripts/run_daily_top_movers_research.py
@@ -187,16 +187,20 @@
     }
 
     # === Step 1.5: Fetch BTC reference klines (once, shared across all tokens) ===
+    # Use cache-poisoning-safe pattern: load_or_fetch may cache [] on API failure.
+    # Re-fetch from API whenever cached result is empty; only save non-empty to cache.
     _btc = "BTCUSDT"
+    def _fetch_btc_safe(key, interval, limit):
+        bars = load_cache(research_day, key)
+        if bars:          # non-empty cached result — use it
+            return bars
+        bars = client.get_klines(_btc, interval, lb_start_ms, day_end_ms, limit=limit)
+        if bars:          # only cache non-empty to avoid poisoning
+            save_cache(research_day, key, bars)
+        return bars or []
     try:
-        btc_bars_15m = load_or_fetch(
-            research_day, f"{_btc}_klines_15m",
-            lambda: client.get_klines(_btc, "15m", lb_start_ms, day_end_ms, limit=200),
-        )
-        btc_bars_1h = load_or_fetch(
-            research_day, f"{_btc}_klines_1h",
-            lambda: client.get_klines(_btc, "1h", lb_start_ms, day_end_ms, limit=60),
-        )
+        btc_bars_15m = _fetch_btc_safe(f"{_btc}_klines_15m", "15m", 200)
+        btc_bars_1h  = _fetch_btc_safe(f"{_btc}_klines_1h",  "1h",  60)
         print(f"  BTC 15m bars: {len(btc_bars_15m)} | BTC 1h bars: {len(btc_bars_1h)}")
     except Exception as _btc_err:
         print(f"  BTC reference fetch failed: {_btc_err}. Context fields will be null.")
